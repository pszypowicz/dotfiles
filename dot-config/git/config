# The blank helper drops helpers inherited from system config (Homebrew git
# ships osxkeychain); GCM is the only helper, and only HTTPS remotes (Azure
# DevOps) reach it - GitHub goes over SSH via the Sequester agent.
[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
	azreposCredentialType = oauth
[push]
	default = current
[pager]
	branch = false
[core]
	autocrlf = false
	eol = lf
	excludesfile = ~/.config/git/ignore
	fileMode = false

[pull]
	ff = only
[init]
	defaultBranch = main

[user]
	name = Przemysław Szypowicz

[includeIf "gitdir:~/Developer/github.com/"]
	path = ~/.config/git/github.config
[include]
	path = ~/.config/git/config.local
[credential "https://dev.azure.com"]
	useHttpPath = true
