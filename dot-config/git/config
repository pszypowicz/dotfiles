# The blank helper drops the helpers inherited from system config (Homebrew
# git ships osxkeychain). GitHub goes over SSH through the Sequester agent, and
# an overlay that needs HTTPS credentials registers its own helper.
[credential]
	helper =
[push]
	default = current
[pager]
	branch = false
[core]
	autocrlf = false
	eol = lf
	excludesfile = ~/.config/git/ignore
	fileMode = false

[pull]
	ff = only
[init]
	defaultBranch = main

# The GitHub no-reply address is the default for every repo, so nothing commits
# under a personal or employer mailbox by accident. A work overlay overrides it
# for its Azure DevOps paths. useConfigOnly is the backstop: if the line below
# ever goes missing, git refuses to commit instead of inventing
# <os-user>@<hostname> and leaking the machine name.
[user]
	name = Przemysław Szypowicz
	email = pszypowicz@users.noreply.github.com
	useConfigOnly = true

# Secret scan for every repository on the machine. Hooks set in config run in
# addition to a repository's own hooks directory, so `pre-commit install` and
# similar tools keep working. Turn one off for a single repository with
# `git config hook.secret-scan-staged.enabled false`.
[hook "secret-scan-staged"]
	event = pre-commit
	command = ~/.config/git/hooks/secret-scan.sh --event pre-commit
[hook "secret-scan-message"]
	event = commit-msg
	command = ~/.config/git/hooks/secret-scan.sh --event commit-msg
[hook "secret-scan-push"]
	event = pre-push
	command = ~/.config/git/hooks/secret-scan.sh --event pre-push

[include]
	path = ~/.config/git/config.local
