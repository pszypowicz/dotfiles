# The blank helper drops helpers inherited from system config (Homebrew git
# ships osxkeychain); GCM is the only helper, and only HTTPS remotes (Azure
# DevOps) reach it - GitHub goes over SSH via the Sequester agent.
[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
	azreposCredentialType = oauth
[push]
	default = current
[pager]
	branch = false
[core]
	autocrlf = false
	eol = lf
	excludesfile = ~/.config/git/ignore
	fileMode = false

[pull]
	ff = only
[init]
	defaultBranch = main

# The GitHub no-reply address is the default for every repo, so nothing commits
# under a personal or employer mailbox by accident. A work overlay overrides it
# for its Azure DevOps paths. useConfigOnly is the backstop: if the line below
# ever goes missing, git refuses to commit instead of inventing
# <os-user>@<hostname> and leaking the machine name.
[user]
	name = Przemysław Szypowicz
	email = pszypowicz@users.noreply.github.com
	useConfigOnly = true

[include]
	path = ~/.config/git/config.local
[credential "https://dev.azure.com"]
	useHttpPath = true
