# Appearance
theme = light:GitHub Light Default,dark:Catppuccin Mocha
font-family = CaskaydiaCove Nerd Font
font-size = 14
macos-option-as-alt = left
window-padding-x = 8
window-padding-y = 8

# No confirmation prompt when closing a window/surface with a running process
confirm-close-surface = false

# This is a self-built fork (the ghostty-personal cask) that shares the
# com.mitchellh.ghostty bundle id. The Sparkle updater is compiled out of
# this build; auto-update stays off as a guard for any stock build that
# ever reads this config.
auto-update = off

# tmux handles multiplexing: unbind only the shortcuts that create a
# Ghostty tab or split by accident. Everything else keeps its defaults.
keybind = super+t=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind

# Command palette off
keybind = super+shift+p=unbind

# Switch tmux windows like Safari tabs (Cmd+Shift+[ and Cmd+Shift+])
# by sending tmux prefix + p / n, the no-wrap window step bindings in
# tmux.conf. The translated [ / ] variants carry the previous/next_tab
# defaults and are unbound so only the physical-key bindings remain.
keybind = super+shift+left_bracket=text:\x02p
keybind = super+shift+right_bracket=text:\x02n
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind

# Paste tmux buffer (Cmd+Shift+V -> tmux prefix + ] -> paste-buffer)
keybind = super+shift+v=text:\x02]

# Trackpad gestures inside tmux are tmux's business: the tmux-personal
# fork enables gesture reporting (DEC 2035), swipes, pinches and
# smart-magnify arrive there as bindable keys, and the bindings live in
# tmux.conf.
# Reported gestures still claim their scroll copy and momentum tail, so
# tmux sees exactly one key per physical swipe. Outside tmux the
# defaults apply (swipes switch tabs, smart-magnify toggles font zoom).
# Pinch stays unbound - no font zoom from pinch.
gesture = pinch-in =
gesture = pinch-out =

# Bell features: keep `attention` (Dock bounce on bell while unfocused) but
# disable `title` so the macOS window title isn't decorated with "🔔 " on a
# pending bell - the title stays a clean "session / window" readout, and the
# notification from Claude Code's page hook is the actual signal.
bell-features = no-system,no-audio,attention,no-title,no-border
