#!/usr/bin/env bash
set -euo pipefail

# macos/sharing - make this machine reachable over the network.
# Idempotent and safe to re-run. Invoked from ../bootstrap, but can also
# be run standalone to re-apply just this block without redoing the rest
# of the bootstrap.
#
# These are system settings rather than user preferences, so they need root
# and live here instead of in macos/defaults, which stays unprivileged.

usage() {
    cat <<'EOF'
Usage: macos/sharing [--help]

Make this machine reachable over the network. Idempotent and safe to re-run.

Touches:
  - Remote Login (System Settings > General > Sharing > Remote Login).
    Remote Login starts the SSH server, which is what lets ssh and mosh reach
    this machine. mosh opens its session over SSH before it switches to its
    own UDP transport, so mosh needs this too.
  - System sleep on AC power, set to never. A sleeping machine answers no
    connection, so the SSH server is only good while the machine is awake.
    Battery power keeps its own timer.

Both settings are read without root, so a run that finds them already in
place asks for no password. Only a write needs root and a sudo password. The
Remote Login write also needs Full Disk Access for the terminal that runs it
(System Settings > Privacy & Security > Full Disk Access). Its state is read
back afterwards, so a blocked write is reported instead of passed over.

Remote Login accepts every account on the machine. To narrow that, put the
accounts in the com.apple.access_ssh group from the Sharing pane.

The sleep timer does not govern a closed lid. A laptop with the lid shut
sleeps unless an external display and a keyboard hold it in clamshell mode.

Options:
  -h, --help    Show this help and exit.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

# Remote Login is the launchd enable state of the sshd service, which is what
# `systemsetup -setremotelogin` flips. `launchctl print-disabled system` lists
# that state for every system service and needs no root, unlike
# `systemsetup -getremotelogin`, which asks for it even to read. A service the
# list does not name counts as off, which only costs a write that finds
# nothing to change.
remote_login_on() {
    [[ $(launchctl print-disabled system) == *'"com.openssh.sshd" => enabled'* ]]
}

# pmset needs root but no Full Disk Access, so it runs before the Remote Login
# write, which a missing grant can block.
#
# `pmset -g custom` prints the stored settings for every power source, so the
# AC value is readable while the machine runs on battery. The read needs no
# root. A sleep timer of 0 means never. The awk tracks the section header, so
# the battery block cannot answer for the AC one.
ac_sleep=$(pmset -g custom |
    awk '/^AC Power:/ {ac = 1; next} /^[^[:space:]]/ {ac = 0} ac && $1 == "sleep" {print $2}')
if [[ $ac_sleep == 0 ]]; then
    echo "System sleep on AC power already off."
else
    echo "Turning system sleep off on AC power..."
    sudo pmset -c sleep 0
fi

if remote_login_on; then
    echo "Remote Login already on."
    exit 0
fi

echo "Turning Remote Login on..."
sudo systemsetup -setremotelogin on

if ! remote_login_on; then
    cat >&2 <<'EOF'
Remote Login is still off after the write. The usual cause is a missing Full
Disk Access grant for the terminal. Add it under System Settings > Privacy &
Security > Full Disk Access, then run `bootstrap sharing` again.
EOF
    exit 1
fi

echo "Remote Login on."
