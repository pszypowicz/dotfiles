Include /Users/pszypowicz/.colima/ssh_config

Include /Users/pszypowicz/.config/colima/ssh_config

Include ~/.ssh/config.d/*.conf

Host *
  # The macOS ssh build connects through Network.framework for a host name with
  # no timeout, and Local Network privacy gates that path. A terminal
  # multiplexer server that outlives its terminal app keeps no responsible app,
  # so LAN names fail inside it with "Undefined error: 0". With a timeout set,
  # ssh resolves the name itself and takes the classic socket path, which the
  # privacy check does not gate.
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 6
  TCPKeepAlive no
  # A forwarded agent lets root on the remote host request signatures with
  # every local key, so a host opts in with its own ForwardAgent in config.d.
  # ssh keeps the first value it obtains, and the Include above comes first.
  ForwardAgent no
