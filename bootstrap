#!/usr/bin/env bash
set -euo pipefail

# Bootstrap - run once on a fresh machine, safe to re-run.
# Handles the public dotfiles and, with --overlay, one private overlay from
# a sibling dotfiles-private-<name> repo. Overlays are plain stow packages
# carrying at most a Brewfile.<name>, an npm-globals list, and a Claude Code
# managed-settings.json; all setup logic lives here.
#
# With no arguments every step runs in order. Pass step names to run only
# those - e.g. `./bootstrap stow` after editing a config, or
# `./bootstrap macos` after changing a default - without redoing the rest.

# Resolve this repo's parent directory so bootstrap works from any clone path.
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PACKAGE_NAME=$(basename "$SCRIPT_DIR")
STOW_DIR=$(dirname "$SCRIPT_DIR")

# brew bundle installs the Brewfile's go entries into $GOPATH/bin, and
# dot-config/zsh/dot-zshenv moves GOPATH under XDG_DATA_HOME. On a fresh
# machine that file is not stowed yet when the brew step runs, so the same
# value is set here; otherwise the tools land in ~/go/bin, which .zprofile
# never puts on PATH.
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export GOPATH="$XDG_DATA_HOME/go"

usage() {
    cat <<'EOF'
Usage: bootstrap [--overlay NAME] [STEP ...]

Set up or refresh this machine from the public dotfiles. Idempotent and safe
to re-run. With no STEP, runs every step. Pass one or more STEP names to run
just those - useful when you only need part of the setup (e.g. `bootstrap
stow` after editing a config, `bootstrap macos` after changing a default).
Steps always run in the order below regardless of how they are listed, so
`brew` precedes the tools it installs.

With --overlay NAME, the brew, stow, and npm steps also apply the private
overlay cloned at ../dotfiles-private-NAME: its Brewfile.NAME is bundled,
its stow package is linked, its managed-settings.json is installed for
Claude Code (with sudo, only when the installed copy differs), and the
npm packages listed in its npm-globals
file (one per line, # comments allowed) are installed. Overlay parts that
do not exist are skipped with a notice.

Steps:
  touchid   Install /etc/pam.d/sudo_local so sudo accepts Touch ID, with sudo
            only when the installed copy is missing or differs. Runs first, so
            every later password prompt in the same run takes a touch instead.
  brew      Install Homebrew if missing, then install packages from the
            Brewfile (plus the overlay Brewfile).
  hooks     Install this repo's pre-commit hook, which scans staged changes
            for secrets with betterleaks.
  stow      Symlink the dotfiles into the home directory with stow (plus the
            overlay package), and install the overlay's Claude Code
            managed-settings.json with sudo when it differs from the
            installed copy.
  codex     Install public defaults and hooks in /etc/codex with sudo
            only when an installed file is missing or its contents differ.
  services  Start the Homebrew services that expect the stowed config to be
            in place (colima, sketchybar).
  npm       Install the global npm tools, including the pinned claude-code
            (plus the overlay npm-globals).
  gh        Install the gh extensions (gh-stack).
  macos     Write the macOS preference defaults.
  sharing   Turn on Remote Login and stop system sleep on AC power, so ssh
            and mosh can reach this machine. Reads both settings without
            sudo and asks for a password only when one needs a write. The
            Remote Login write also needs Full Disk Access for the terminal.

Options:
  --overlay NAME   Apply the dotfiles-private-NAME overlay on top of the
                   public dotfiles (e.g. --overlay personal, --overlay work).
                   No default; without it only the public dotfiles are set up.
  -h, --help       Show this help and exit.

Examples:
  bootstrap --overlay personal      # full setup including the personal overlay
  bootstrap --overlay work stow     # re-link public and work config
  bootstrap macos                   # re-write macOS defaults only
  bootstrap codex                   # install public Codex defaults only
  bootstrap touchid                 # turn on Touch ID for sudo only
EOF
}

# /etc/pam.d/sudo_local is Apple's hook for a local addition to the sudo PAM
# stack: /etc/pam.d/sudo includes it, and a macOS update rewrites
# /etc/pam.d/sudo while leaving this file alone. Apple ships the path as
# sudo_local.template, so a fresh machine has no sudo_local at all.
#
# Root owns the path, so the install needs sudo. The compare runs unprivileged
# because the file is world-readable, and only a difference costs a password.
# Mode 444 matches the other files in /etc/pam.d.
#
# This step deliberately runs before every other one: once the file is in
# place, the sudo prompts in the later steps take a touch.
step_touchid() {
    local source_file="$SCRIPT_DIR/etc/pam.d/sudo_local"
    local installed="/etc/pam.d/sudo_local"

    if [[ ! -r $source_file ]]; then
        echo "Cannot read the sudo PAM file: $source_file" >&2
        return 1
    fi
    if cmp -s "$source_file" "$installed"; then
        echo "Touch ID for sudo already configured."
        return
    fi

    echo "Installing the sudo PAM configuration (sudo)..."
    sudo install -m 444 "$source_file" "$installed"
}

step_brew() {
    if ! command -v brew &>/dev/null; then
        echo "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi

    # Tap trust is declared in the Brewfile itself: tap-qualified entries carry
    # `trusted: true` (Homebrew >= 6.0), and brew bundle trusts each such entry
    # before installing it. Trust stays scoped to the exact formulae and casks we
    # install rather than blanket-trusting whole taps.
    local brewfile="$SCRIPT_DIR/dot-config/brewfile/Brewfile"
    echo "Installing packages..."
    brew bundle --file "$brewfile"

    if [[ -n $OVERLAY ]]; then
        local overlay_brewfile="$OVERLAY_DIR/dot-config/brewfile/Brewfile.$OVERLAY"
        if [[ ! -f $overlay_brewfile ]]; then
            echo "No $OVERLAY overlay Brewfile, skipping."
            return
        fi
        echo "Installing $OVERLAY overlay packages..."
        brew bundle --file "$overlay_brewfile"
    fi
}

# Git keeps hooks in .git/hooks, which no clone carries, so the secret scan has
# to be re-installed per checkout. The hook itself shells out to the betterleaks
# binary from the Brewfile rather than a copy in the pre-commit cache, so brew
# is the only place the tool's version is set.
step_hooks() {
    echo "Installing the pre-commit hook..."
    (cd "$SCRIPT_DIR" && pre-commit install)
}

# stow only unlinks a target whose file still exists in the package, because
# unstow works by walking the package tree. A file deleted from the repo
# therefore leaves a broken symlink in the home directory for good, and stow
# never mentions it again. This sweeps those up after a stow run.
#
# A link is only removed when it is broken AND its target path points back
# into the stow directory, so a broken link owned by some other tool stays put.
#
# The scan roots come from the package's own top level, which keeps the sweep
# to a few small directories instead of a walk of $HOME. The gap: a top-level
# directory that a package drops entirely is no longer named by anything, so
# nothing sends the sweep there.
# Drop the directories that the link sweep just emptied, and their parents.
# With --no-folding every package subdirectory is a real directory in the
# target, so a package that drops a whole subtree leaves the directories
# behind after the links go. rmdir refuses a directory that still holds
# anything, so real content is never at risk. The walk stops below $HOME.
prune_empty_dirs() {
    local dir=$1
    while [[ $dir == "$HOME"/?* ]]; do
        rmdir "$dir" 2>/dev/null || return 0
        echo "  dropped empty dir:  ${dir#"$HOME"/}"
        dir=$(dirname "$dir")
    done
}

prune_stale_links() {
    local pkg_dir=$1
    local rel_stow=${STOW_DIR#"$HOME"/}
    local entry name target link removed=0

    if [[ $rel_stow == "$STOW_DIR" ]]; then
        echo "Stow directory sits outside \$HOME, skipping the stale-link sweep." >&2
        return 0
    fi

    for entry in "$pkg_dir"/*; do
        name=$(basename "$entry")
        target="$HOME/${name/#dot-/.}"
        [[ -e $target || -L $target ]] || continue

        while IFS= read -r -d '' link; do
            [[ -e $link ]] && continue
            case $(readlink "$link") in
                *"$rel_stow"/*)
                    rm -f "$link"
                    echo "  dropped stale link: ${link#"$HOME"/}"
                    removed=$((removed + 1))
                    prune_empty_dirs "$(dirname "$link")"
                    ;;
            esac
        done < <(find "$target" -type l -print0 2>/dev/null)
    done

    [[ $removed -eq 0 ]] || echo "Dropped $removed stale link(s) left behind by deleted files."
}

# Root owns the managed-settings path, so writing it needs sudo. The
# installed file is world-readable under a world-executable directory, so this
# check runs unprivileged and the write only happens when something differs.
# Content, mode, and owner all have to match; every other case, including an
# unreadable or absent file, falls through to the privileged install.
# `install -m 644` under sudo yields root:wheel, hence 644 0 0.
managed_settings_current() {
    local src=$1 dst=$2
    [[ -f $dst ]] || return 1
    cmp -s "$src" "$dst" || return 1
    [[ $(stat -f '%Lp %u %g' "$dst") == "644 0 0" ]]
}

step_stow() {
    # --no-folding forces stow to create every package subdirectory as a real
    # directory in the target and symlink individual files, instead of collapsing
    # whole subtrees into a single dir-symlink. This matters for any config
    # directory where the tool writes live runtime state next to tracked files
    # (Claude Code's ~/.config/claude is the obvious case: history.jsonl,
    # projects/, sessions/, caches, etc.). With folding, those writes would
    # pass through a dir-symlink and land inside the git repo; without folding,
    # the target dir is real and the runtime writes stay local.
    echo "Stowing dotfiles..."
    stow -d "$STOW_DIR" -t ~ "$PACKAGE_NAME" --dotfiles --restow --no-folding
    prune_stale_links "$SCRIPT_DIR"

    if [[ -n $OVERLAY ]]; then
        echo "Stowing $OVERLAY overlay..."
        stow -d "$STOW_DIR" -t ~ "dotfiles-private-$OVERLAY" --dotfiles --restow --no-folding
        prune_stale_links "$OVERLAY_DIR"

        # Claude Code reads machine-scoped managed settings from a path
        # outside the stow target, so the overlay copy is installed there
        # rather than linked. Machine-only Claude config (per-machine plugin
        # and MCP overrides) lives in this file because the user-scope
        # settings.json is shared across machines via the public package.
        local managed_settings="$OVERLAY_DIR/managed-settings.json"
        local managed_dir="/Library/Application Support/ClaudeCode"
        local installed="$managed_dir/managed-settings.json"
        if [[ ! -f $managed_settings ]]; then
            echo "No $OVERLAY overlay managed-settings.json, skipping."
        elif managed_settings_current "$managed_settings" "$installed"; then
            echo "$OVERLAY overlay Claude Code managed settings already current."
        else
            echo "Installing $OVERLAY overlay Claude Code managed settings (sudo)..."
            sudo install -d -m 755 "$managed_dir"
            sudo install -m 644 "$managed_settings" "$installed"
        fi
    fi

    # Codex reads its user-level instructions from AGENTS.md inside CODEX_HOME
    # and has no include directive, so the Claude instruction file and the
    # overlay it imports are flattened into one generated file there. That file
    # is written rather than stowed, because the merged form exists only on
    # disk. The fallback path repeats the CODEX_HOME export in
    # dot-config/zsh/dot-zshenv, which is not in effect during a fresh
    # machine's first run.
    echo "Generating Codex instructions..."
    CODEX_HOME="${CODEX_HOME:-$HOME/.config/codex}" \
        "$SCRIPT_DIR/dot-local/bin/build-codex-agents-md"

    # SketchyBar builds its item list once, when it runs sketchybarrc at
    # launch. An edit under items/ therefore does nothing until the bar
    # restarts, and the plugin that references a new item logs
    # "Item not found" on every tick until then. Plugin scripts are re-read
    # from disk on each invocation, so those need no restart.
    #
    # Only restart a bar that is already up: on a fresh machine the services
    # step starts it, after this step puts the config in place.
    #
    # The restart is a convenience, so a failure here must not take the run
    # down with it under `set -e`. The stowed config is already in place, and
    # the remaining steps do not depend on the bar.
    if pgrep -xq sketchybar; then
        echo "Restarting sketchybar..."
        brew services restart sketchybar ||
            echo "sketchybar restart failed, continuing without it." >&2
    fi
}

step_codex() {
    local source_dir="$SCRIPT_DIR/etc/codex"
    local dir="/etc/codex"
    local file
    local -a files=(hooks/block-force-push.sh hooks/format-edits.py config.toml)
    local -a changed=()

    for file in "${files[@]}"; do
        if [[ ! -r $source_dir/$file ]]; then
            echo "Cannot read public Codex file: $source_dir/$file" >&2
            return 1
        fi
        if ! cmp -s "$source_dir/$file" "$dir/$file"; then
            changed+=("$file")
        fi
    done
    if [[ ${#changed[@]} -eq 0 ]]; then
        echo "Codex system configuration and hooks already match."
        return
    fi

    echo "Installing Codex system configuration and hooks (sudo)..."
    sudo install -d -m 755 "$dir" "$dir/hooks"
    for file in "${changed[@]}"; do
        sudo install -m 644 "$source_dir/$file" "$dir/$file"
    done
}

step_services() {
    # Colima's first start adds an Include line to ~/.ssh/config and creates
    # the file when it is missing. The stowed ssh config already carries that
    # line, so the service starts after stow. Started from the Brewfile
    # (start_service: true), it runs inside the brew step, and the plain file
    # it leaves behind makes the stow step fail with a conflict.
    #
    # SketchyBar reads ~/.config/sketchybar at launch and only picks up later
    # edits on a restart, so it also belongs here rather than in the Brewfile.
    echo "Starting services..."
    brew services start colima
    brew services start sketchybar
}

step_npm() {
    # claude-code is pinned to the exact version whose changelog was last reviewed
    # against these dotfiles; the claude-code-update skill bumps the pin on each
    # update, so a fresh machine gets the reviewed version rather than blind
    # @latest.
    # The Brewfile's node formula provides npm. A missing npm means that
    # formula is absent or unlinked (brew link node), and a silent skip here
    # would leave the machine without claude-code.
    if ! command -v npm &>/dev/null; then
        echo "npm not found on PATH: install or link the node formula, then re-run the npm step." >&2
        exit 1
    fi
    echo "Installing npm globals..."
    # claude-code's postinstall places the native binary over a stub, and
    # npm 12 blocks dependency install scripts unless allowlisted. The spec
    # is name-only on purpose: pin bumps stay covered, and the changelog
    # script's pin grep only matches the versioned entry below.
    npm install -g \
        --allow-scripts=@anthropic-ai/claude-code \
        @anthropic-ai/claude-code@2.1.280 \
        @lhci/cli \
        cf \
        lighthouse

    if [[ -n $OVERLAY ]]; then
        local globals_file="$OVERLAY_DIR/npm-globals"
        if [[ ! -f $globals_file ]]; then
            echo "No $OVERLAY overlay npm-globals file, skipping."
            return
        fi
        local -a overlay_globals=()
        local pkg
        while IFS= read -r pkg; do
            overlay_globals+=("$pkg")
        done < <(grep -vE '^[[:space:]]*(#|$)' "$globals_file")
        if [[ ${#overlay_globals[@]} -eq 0 ]]; then
            echo "No packages listed in $globals_file, skipping."
            return
        fi
        echo "Installing $OVERLAY overlay npm globals..."
        npm install -g "${overlay_globals[@]}"
    fi
}

# gh extensions install through gh itself, so the Brewfile cannot carry them.
# A public binary extension needs no token, so this runs before `gh auth
# login` on a fresh machine. --force keeps a re-run from failing on an
# extension that is already present: an outdated one is upgraded, a current
# one is left alone.
step_gh() {
    echo "Installing gh extensions..."
    gh extension install --force github/gh-stack
}

step_macos() {
    echo "Writing macOS defaults..."
    "$SCRIPT_DIR/macos/defaults"
}

# Kept out of the macos step because that one writes user preferences and
# never asks for a password. This one writes system settings through sudo,
# and only when a setting differs from the wanted state.
step_sharing() {
    "$SCRIPT_DIR/macos/sharing"
}

# Parse arguments into the set of steps to run. No step names -> run all.
OVERLAY=""
run_brew=false run_stow=false run_services=false run_npm=false run_gh=false
run_macos=false run_sharing=false run_hooks=false run_codex=false
run_touchid=false
any_step=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --overlay)
            [[ $# -ge 2 ]] || { echo "--overlay requires a value" >&2; usage >&2; exit 2; }
            OVERLAY="$2"
            shift
            ;;
        touchid)  run_touchid=true;  any_step=true ;;
        brew)     run_brew=true;     any_step=true ;;
        hooks)    run_hooks=true;    any_step=true ;;
        stow)     run_stow=true;     any_step=true ;;
        codex)    run_codex=true;    any_step=true ;;
        services) run_services=true; any_step=true ;;
        npm)      run_npm=true;      any_step=true ;;
        gh)       run_gh=true;       any_step=true ;;
        macos)    run_macos=true;    any_step=true ;;
        sharing)  run_sharing=true;  any_step=true ;;
        *) echo "unknown step: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

# The overlay is a sibling checkout; resolving it up front makes a typo in
# the name fail before any step has run.
OVERLAY_DIR=""
if [[ -n $OVERLAY ]]; then
    OVERLAY_DIR="$STOW_DIR/dotfiles-private-$OVERLAY"
    if [[ ! -d $OVERLAY_DIR ]]; then
        echo "overlay '$OVERLAY' not found: expected a checkout at $OVERLAY_DIR" >&2
        exit 2
    fi
fi

if [[ $any_step == false ]]; then
    run_brew=true run_stow=true run_services=true run_npm=true run_gh=true
    run_macos=true run_sharing=true run_hooks=true run_codex=true
    run_touchid=true
fi

# Run selected steps in dependency order: touchid needs nothing and turns the
# password prompts of the steps below it into a fingerprint, so it goes first;
# brew provides the tools the later steps rely on (stow, node/npm, gh), so it
# follows; and services start only once stow has put their config in place.
if $run_touchid;  then step_touchid;  fi
if $run_brew;     then step_brew;     fi
if $run_hooks;    then step_hooks;    fi
if $run_stow;     then step_stow;     fi
if $run_codex;    then step_codex;    fi
if $run_services; then step_services; fi
if $run_npm;      then step_npm;      fi
if $run_gh;       then step_gh;       fi
if $run_macos;    then step_macos;    fi
if $run_sharing;  then step_sharing;  fi

echo "Done."
